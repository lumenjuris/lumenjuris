{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Frontend (Vite/React)",
      "cwd": "lumenjuris/front",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 5173,
      "autoPort": false
    },
    {
      "name": "Proxy (Express)",
      "cwd": "lumenjuris/proxy",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    },
    {
      "name": "BackNode (Express/API)",
      "cwd": "lumenjuris/backNode",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3020
    },
    {
      "name": "Word Add-in (statique dist)",
      "cwd": "lumenjuris/word-addin",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["--yes", "http-server", "dist", "-p", "8099", "-c-1"],
      "port": 8099
    },
    {
      "name": "Back Python (FastAPI)",
      "cwd": "lumenjuris",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "back.app.main:app", "--reload", "--port", "5678"],
      "port": 5678
    },
    {
      "name": "Aperçus savons Purisève (statique)",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8123", "--directory",
        "C:/Users/geoff/Documents/Purisève/wp-pipeline/savons"],
      "port": 8123
    }
  ]
}
